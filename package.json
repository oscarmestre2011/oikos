{
  "name": "oikos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PWA para llevar las cuentas personales: ingresos, gastos, inversion, amortizacion y patrimonio. Sin servidor ni cuentas.",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "copia:personal": "vite-node scripts/generar-copia-personal.ts",
    "comprobar:flujo": "node scripts/comprobar-flujo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "test:flujos": "node scripts/flujos.mjs",
    "test:copia": "node scripts/test-copia-personal.mjs",
    "test:sw": "node scripts/diagnostico-sw.mjs",
    "test:pages": "node scripts/verify-pages.mjs",
    "test:live": "node scripts/verify-live.mjs",
    "publicar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publicar.ps1",
    "verify": "npm run typecheck && npm test && npm run build",
    "verify:all": "npm run comprobar:flujo && npm run verify && npm run test:smoke && npm run test:flujos && npm run test:copia && npm run build:pages && npm run test:pages"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
